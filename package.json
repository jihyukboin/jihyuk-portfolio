{
  "name": "jihyuk-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3007",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "next start",
    "start:standalone": "node scripts/start-standalone.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "npm run build && playwright test --config test/playwright.config.ts",
    "test:chat": "npm run build && node --test test/integration/chat.test.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:fix": "npm run lint -- --fix",
    "lint:ci": "eslint . --max-warnings 0 --cache --cache-strategy content --cache-location .eslintcache"
  },
  "dependencies": {
    "@next/env": "^16.4.3",
    "@next/third-parties": "16.4.3",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.63.0",
    "mysql2": "^3.24.6",
    "next": "16.4.3",
    "openai": "^7.45.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-cjk-friendly": "^2.3.3",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.2",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "swr": "^2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-github-action": "^0.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  }
}
