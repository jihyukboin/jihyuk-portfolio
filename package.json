{
  "name": "jihyuk-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3007",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "next start",
    "start:standalone": "node scripts/start-standalone.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "lint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "npm run build && playwright test --config test/playwright.config.ts",
    "test:chat": "npm run build && node --test test/integration/chat.test.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:fix": "npm run lint -- --fix",
    "lint:ci": "npm run lint"
  },
  "dependencies": {
    "@next/env": "^16.4.4",
    "@next/third-parties": "16.4.4",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "mysql2": "^3.24.6",
    "next": "16.4.4",
    "openai": "^7.47.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-cjk-friendly": "^2.3.3",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.2",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "swr": "^2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.13.0": true
  }
}
