#!/usr/bin/env bash

set -euo pipefail

app_root="/opt/jihyuk-portfolio"
deploy_user="jihyuk-deploy"
deploy_home="/var/lib/jihyuk-deploy"

if [[ $# -ne 1 || ! -s "$1" ]]; then
  echo "usage: bootstrap <deploy-public-key>" >&2
  exit 64
fi

public_key="$1"

if ! id "$deploy_user" >/dev/null 2>&1; then
  useradd --create-home --home-dir "$deploy_home" --shell /bin/bash --user-group "$deploy_user"
fi

install -d -o "$deploy_user" -g "$deploy_user" -m 0755 \
  "$app_root" \
  "$app_root/builds" \
  "$app_root/releases"
install -d -o "$deploy_user" -g "$deploy_user" -m 0700 \
  "$app_root/shared"
install -d -o "$deploy_user" -g "$deploy_user" -m 0755 \
  "$deploy_home/.config" \
  "$deploy_home/.config/systemd" \
  "$deploy_home/.config/systemd/user"

install -d -o "$deploy_user" -g "$deploy_user" -m 0700 "$deploy_home/.ssh"
install -o "$deploy_user" -g "$deploy_user" -m 0600 "$public_key" "$deploy_home/.ssh/authorized_keys"

loginctl enable-linger "$deploy_user"
deploy_uid="$(id -u "$deploy_user")"
systemctl start "user@$deploy_uid.service"
